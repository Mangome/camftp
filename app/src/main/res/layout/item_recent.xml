<?xml version="1.0" encoding="utf-8"?>
<!-- 「最近收到」一行小图里的一格（64dp 见方，最新一张之外的那 5 张）。
     缩略图本身是内容，格子不加阴影、不加描边，文件名也不写（格子太小，写了到 5 列只有几个字，
     看的是画面不是编号）—— 整屏唯一的高峰还是连接面板那块暗底。
     出不了图（RAW 抽不出预览 / 原图已从相册删掉 / 非媒体文件）时是灰底 + 居中后缀，点击行为不变 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 圆角和点击水波纹都交给卡片（自己给 ImageView 切圆角要玩 clipToOutline）。
         底是缩略图的占位色（设计稿的 ThumbBg）：解码没回来之前不闪白 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/cam_thumb_bg"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <io.github.mangome.camftp.SquareFrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/tileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- 说清楚「这一格是什么」比一个通用破图图标有用：NEF / MP4 / TXT -->
            <TextView
                android:id="@+id/tileBadge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone" />
        </io.github.mangome.camftp.SquareFrameLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
