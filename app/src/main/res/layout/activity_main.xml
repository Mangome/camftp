<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 36 → 系统强制 edge-to-edge，内容会画到状态栏/导航栏底下。
     根是 FrameLayout：底下那层 panelBackdrop 把连接面板的底色一直铺到屏幕顶端（状态栏那一条也是它），
     上面是原来的 ScrollView（fitsSystemWindows 把系统栏 insets 变成它的 padding，内容因此不会压在栏下。
     内边距要留在子 View 上，否则 View.computeSystemWindowInsets 认为该边已有 padding 就不再补 inset）。
     backdrop 的高度随滚动收缩，见 MainActivity.syncBackdrop()。
     结构：相机连接面板（唯一暗块）→ 最近收到（大图 + 一行小图 + 失败条）→ 相机读数 → 热点设置入口
           → 高级设置（折叠）→ 关于。
     没有卡片：分区靠 1dp 细线 + 留白，整屏唯一的视觉高峰是面板那块暗底。 -->
<!-- keepScreenOn：App 在前台时不熄屏（对着屏幕抄地址、拍完照看「最近收到」都不用反复点亮）。
     系统按「这个窗口可见」判定，退到后台自动失效，不需要在 onPause 里手动清 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="false">

    <View
        android:id="@+id/panelBackdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/cam_instrument" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:keepScreenOn="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 相机连接面板：整屏视觉主角（唯一一块暗色 + 唯一的动效），也是唯一通栏的元素
                 —— 底色一路铺到屏幕顶端（panelBackdrop），所以左/右/上三边都不吃内容区的页边距。
                 「相机连上了没」比地址重要：地址只在给相机填配置时用一次，连接状态是拍摄现场一直盯着的。
                 状态词由 updateCameraHint() 唯一负责（只有它知道有没有热点），别在别处 setText；
                 面板底色也在那同一个 when 里选（三档暗色，见 colors.xml）—— 这里只给闲置那档兜底。
                 上内边距 20dp 之外还有状态栏那一条（insets 给 ScrollView 的 padding），合计 44dp -->
            <LinearLayout
                android:id="@+id/linkPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/cam_instrument"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_margin"
                android:paddingTop="20dp"
                android:paddingEnd="@dimen/page_margin"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 连上时呼吸（相机机身那颗传输灯的意思），颜色/动画都在 setLinkLamp() 里管 -->
                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/dot"
                        android:backgroundTint="@color/cam_link_off" />

                    <!-- lineHeight 必须显式给（同 addressValue）：不写就是赌 ROM 的字体度量 -->
                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.02"
                        android:lineHeight="34sp"
                        android:text="@string/status_need_hotspot"
                        android:textColor="@color/cam_on_instrument"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 副行：传输中报文件名 / 断开但连过时报「上次连接 HH:mm」 -->
                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:lineHeight="22sp"
                    android:textColor="@color/cam_on_instrument_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_margin"
                android:paddingTop="20dp"
                android:paddingEnd="@dimen/page_margin"
                android:paddingBottom="32dp">

                <!-- 2. 最近收到：照片是拍摄现场最想看到的东西，排在最前面。
                     「传了没进相册」的失败条目紧跟在小图条下方 —— 那是唯一的线索 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:lineHeight="20sp"
                            android:text="@string/section_events_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- 「已收 N 张 / 上限 · 最新那张的时间」：网格的容量刻度，空态时也写「0 / 12」 -->
                        <TextView
                            android:id="@+id/eventCount"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="monospace"
                            android:gravity="center_vertical"
                            android:lineHeight="20sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- 最新一张：16:9（390dp 机身下 350 × 186）。整块可点，点开相册里的原图 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/heroCard"
                        android:layout_width="match_parent"
                        android:layout_height="186dp"
                        android:layout_marginTop="12dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/cam_thumb_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/heroImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <!-- 出不了图（RAW 抽不出预览 / 原图已删 / 非媒体文件）：后缀比通用破图图标说得清楚 -->
                            <TextView
                                android:id="@+id/heroBadge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"
                                android:visibility="gone" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- 除最新一张外的最近 5 张：一行 64dp 小图。行内格子等宽（补 Space 撑住），
                         行和格子在 MainActivity.renderThumbs() 里按条目拼（≤5 个，不需要 RecyclerView） -->
                    <LinearLayout
                        android:id="@+id/eventRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:visibility="gone" />

                    <!-- 空态：什么都还没入库时的出口。虚线卡 = 「这里以后会有东西」的占位；
                         出口本身走真实入库链路写一张测试图（真图或自检图成功一次后整块收起） -->
                    <LinearLayout
                        android:id="@+id/eventEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_event_empty"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="30dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="30dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_image_off"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineHeight="20sp"
                            android:text="@string/event_none"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textFontWeight="500"
                            android:textSize="14sp" />

                        <!-- 描边按钮：这块里唯一的动作（设计稿是描边 + 主色字，不用色块，
                             免得跟上面那块暗面板抢注意力） -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/selfTestButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="148dp"
                            android:text="@string/self_test"
                            android:textSize="14sp"
                            app:cornerRadius="14dp"
                            app:strokeColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- 只放失败条目（没有图）：「相机传了但没进相册」的唯一线索，每条一个圆角底条 -->
                    <LinearLayout
                        android:id="@+id/eventFailures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- 3. 相机里要填的那串字：全屏唯一的读数（相机要照着逐字输）。
                     没有卡片：直接落在页面底上，靠细线与留白跟照片分开 -->
                <LinearLayout
                    android:id="@+id/readingBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <!-- 整屏唯一的大字读数（相机要照着逐字输）。lineHeight 必须显式给：
                         Xiaomi MIX Flip 2 / HyperOS 3（fontScale 1.1 / 520dpi）上这个字号只量出
                         91px 行高（其余字号都是 1.35~1.38×，正常该 ~168px），字被切掉顶部。
                         显式行高 = 不依赖 ROM 的字体度量 -->
                    <TextView
                        android:id="@+id/addressValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.01"
                        android:lineHeight="44sp"
                        android:text="@string/camera_no_ip"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <!-- 参数用值格：标签 11sp 放在值上方。匿名登录时是 2 格（端口 / 登录），
                         账号密码时是 3 格（端口 / 用户 / 密码）—— 格子按权重分宽，显隐即换列数 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineHeight="16sp"
                                android:text="@string/field_port"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/portValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:lineHeight="24sp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/loginCell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineHeight="16sp"
                                android:text="@string/field_login"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:lineHeight="24sp"
                                android:text="@string/field_login_anonymous"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/userCell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineHeight="16sp"
                                android:text="@string/field_user"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/userValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:lineHeight="24sp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/passwordCell"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:lineHeight="16sp"
                                android:text="@string/field_password"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/passwordValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:lineHeight="24sp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/anonymousNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineHeight="20sp"
                        android:text="@string/camera_anonymous_note"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 不在热点上：相机用不了这个地址，就别把 IP 摆成主角。
                     最后一行是兜底：换 ROM 认不出热点网卡名时，地址还能手工抄 -->
                <LinearLayout
                    android:id="@+id/noIpBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineHeight="22sp"
                        android:text="@string/camera_need_hotspot"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/localAddresses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:lineHeight="20sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 4. 热点设置入口：常驻（关掉 / 换密码都从这儿进），不跟状态一起隐显。
                     排在读数之后 —— 先看地址，再决定要不要动热点 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hotspotButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/open_hotspot"
                    android:textColor="@color/cam_primary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/cam_primary_tonal"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_hotspot"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/cam_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- 5. 高级设置：低频操作，默认收起。展开后字段直接落在页面上，不再套一层卡 -->
                <LinearLayout
                    android:id="@+id/advancedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineHeight="20sp"
                        android:text="@string/section_advanced"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/advancedChevron"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/section_advanced"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/advancedBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineHeight="20sp"
                        android:text="@string/label_port"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <!-- 输入框别用 TextInputLayout：它的浮动标签会给 EditText 强加 16dp 上下内边距，
                         48dp 的框把 15sp 的字裁掉一半（真机实测）。现在是 EditText + bg_field 自绘 -->
                    <EditText
                        android:id="@+id/portInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="15sp" />

                    <!-- 错误提示长在框下面（设计稿），同时框的描边换错误色，见 showFieldError() -->
                    <TextView
                        android:id="@+id/portError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineHeight="18sp"
                        android:textColor="?attr/colorError"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:lineHeight="20sp"
                        android:text="@string/label_folder"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/folderInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:fontFamily="monospace"
                        android:gravity="center_vertical"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/folderError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineHeight="18sp"
                        android:textColor="?attr/colorError"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/anonymousSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:text="@string/label_anonymous"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp" />

                    <!-- 匿名登录时这两项用不上：整块降到 0.42 不透明度（见 MainActivity），
                         不藏起来 —— 藏了用户就不知道关掉开关之后要填什么 -->
                    <LinearLayout
                        android:id="@+id/userField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineHeight="20sp"
                            android:text="@string/label_user"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/userInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_field"
                            android:fontFamily="monospace"
                            android:gravity="center_vertical"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/userError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineHeight="18sp"
                            android:textColor="?attr/colorError"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/passwordField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineHeight="20sp"
                            android:text="@string/label_password"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/passwordInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_field"
                            android:fontFamily="monospace"
                            android:gravity="center_vertical"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/passwordError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineHeight="18sp"
                            android:textColor="?attr/colorError"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="24dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/save"
                        android:textSize="15sp"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- 6. 关于：版权 / 版本 / 开源信息，视觉最弱的一行 -->
                <LinearLayout
                    android:id="@+id/aboutButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineHeight="20sp"
                        android:text="@string/about"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
