<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 1. 状态 + 开关 -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_stopped"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start" />

        <Button
            android:id="@+id/selfTestButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/self_test" />

        <!-- 2. 念给相机听的那串字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_camera_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cameraHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/ip_none"
            android:textSize="18sp" />

        <Button
            android:id="@+id/copyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy" />

        <!-- 3. 配置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_config_title"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_port"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/passivePortsInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_passive"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/userInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_user"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_password"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/folderInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_folder"
            android:inputType="text"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <!-- 4. 网卡列表 + 热点 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_ip_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ipList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/ip_none" />

        <Button
            android:id="@+id/hotspotButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_hotspot" />

        <!-- 5. 最近事件 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_events_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/event_none"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
