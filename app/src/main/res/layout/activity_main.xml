<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdk 36 → 系统强制 edge-to-edge，内容会画到状态栏/导航栏底下。
     根是 FrameLayout：底下那层 panelBackdrop 把连接面板的底色一直铺到屏幕顶端（状态栏那一条也是它），
     上面是原来的 ScrollView（fitsSystemWindows 把系统栏 insets 变成它的 padding，内容因此不会压在栏下。
     内边距要留在子 View 上，否则 View.computeSystemWindowInsets 认为该边已有 padding 就不再补 inset）。
     backdrop 的高度随滚动收缩，见 MainActivity.syncBackdrop()。
     结构：相机连接面板（主角，通栏）→ 热点设置入口 → 相机读数卡 → 高级设置（折叠） → 最近收到 → 关于 -->
<!-- keepScreenOn：App 在前台时不熄屏（对着屏幕抄地址、拍完照看「最近收到」都不用反复点亮）。
     系统按「这个窗口可见」判定，退到后台自动失效，不需要在 onPause 里手动清 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="false">

    <View
        android:id="@+id/panelBackdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/cam_instrument" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fitsSystemWindows="true"
        android:keepScreenOn="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 相机连接面板：整屏视觉主角（唯一一块暗色 + 唯一的动效），也是唯一通栏的元素
                 —— 底色一路铺到屏幕顶端（panelBackdrop），所以左/右/上三边都不吃内容区的 20dp 内边距。
                 「相机连上了没」比地址重要：地址只在给相机填配置时用一次，连接状态是拍摄现场一直盯着的。
                 状态词由 updateCameraHint() 唯一负责（只有它知道有没有热点），别在别处 setText；
                 面板底色也在那同一个 when 里选（三档暗色，见 colors.xml）—— 这里只给闲置那档兜底 -->
            <LinearLayout
                android:id="@+id/linkPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/cam_instrument"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="6dp"
                android:paddingEnd="20dp"
                android:paddingBottom="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 连上时呼吸（相机机身那颗传输灯的意思），颜色/动画都在 setLinkLamp() 里管 -->
                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/dot"
                        android:backgroundTint="@color/cam_link_off" />

                    <!-- lineHeight 必须显式给（同 addressValue）：不写就是赌 ROM 的字体度量 -->
                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.02"
                        android:lineHeight="34sp"
                        android:text="@string/status_need_hotspot"
                        android:textColor="@color/cam_on_instrument"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 副行：传输中报文件名 / 断开但连过时报「上次连接 HH:mm」 -->
                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:lineHeight="22sp"
                    android:textColor="@color/cam_on_instrument_variant"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

                <!-- 2. 热点设置入口：热点开着时也常驻（关掉 / 换密码都从这儿进），不跟状态一起隐显。
                     没热点时的提示在状态行上（status_need_hotspot），不再单独出错误色卡 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hotspotButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/open_hotspot"
                    android:textColor="@color/cam_primary"
                    android:textSize="16sp"
                    app:backgroundTint="@color/cam_primary_tonal"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_hotspot"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/cam_primary" />

                <!-- 3. 相机里要填的那串字：全屏唯一的读数 -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.06"
                                android:text="@string/section_camera_title"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <!-- 「热点」标记跟标题同行：34sp 等宽下 `10.130.223.120` 已经占满整张卡片
                                 （实测 953/964px），地址行里再也塞不下它，塞了就会被挤出屏幕 -->
                            <TextView
                                android:id="@+id/hotspotTag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:text="@string/ip_hotspot_tag"
                                android:textColor="@color/cam_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- 有地址：念给相机听的那几行 -->
                        <LinearLayout
                            android:id="@+id/readingBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 整屏唯一的大字读数（相机要照着逐字输）。lineHeight 必须显式给：
                                 Xiaomi MIX Flip 2 / HyperOS 3（fontScale 1.1 / 520dpi）上这个字号只量出
                                 91px 行高（其余字号都是 1.35~1.38×，正常该 ~168px），字被切掉顶部。
                                 显式行高 = 不依赖 ROM 的字体度量 -->
                            <TextView
                                android:id="@+id/addressValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.01"
                                android:lineHeight="44sp"
                                android:text="@string/camera_no_ip"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="34sp"
                                android:textStyle="bold" />

                            <!-- 分隔线：把「照抄的地址」和下面三行参数分开 -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="16dp"
                                android:background="?attr/colorOutline" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="22dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="56dp"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical"
                                        android:text="@string/field_port"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/portValue"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:fontFamily="monospace"
                                        android:gravity="center_vertical"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/userRow"
                                    android:layout_width="match_parent"
                                    android:layout_height="22dp"
                                    android:layout_marginTop="12dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="56dp"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical"
                                        android:text="@string/field_user"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/userValue"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:fontFamily="monospace"
                                        android:gravity="center_vertical"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/passwordRow"
                                    android:layout_width="match_parent"
                                    android:layout_height="22dp"
                                    android:layout_marginTop="12dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="56dp"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical"
                                        android:text="@string/field_password"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="14sp" />

                                    <TextView
                                        android:id="@+id/passwordValue"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:fontFamily="monospace"
                                        android:gravity="center_vertical"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/anonymousNote"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:lineSpacingExtra="2dp"
                                    android:text="@string/camera_anonymous_note"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp"
                                    android:visibility="gone" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 不在热点上：相机用不了这个地址，就别把 IP 摆成主角。
                             最后一行是兜底：换 ROM 认不出热点网卡名时，地址还能手工抄 -->
                        <LinearLayout
                            android:id="@+id/noIpBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/camera_need_hotspot"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/localAddresses"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="monospace"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. 高级设置：低频操作，默认收起 -->
                <com.google.android.material.card.MaterialCardView
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/advancedHeader"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/section_advanced"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/advancedChevron"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@string/section_advanced"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="?attr/colorOutline" />

                        <LinearLayout
                            android:id="@+id/advancedBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingTop="16dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="20dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_port"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/portInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_field"
                                android:fontFamily="monospace"
                                android:gravity="center_vertical"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:textSize="15sp" />

                            <!-- 错误提示长在框下面（设计稿），同时框的描边换错误色，见 showFieldError() -->
                            <TextView
                                android:id="@+id/portError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="?attr/colorError"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/label_folder"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/folderInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_field"
                                android:fontFamily="monospace"
                                android:gravity="center_vertical"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/folderError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="?attr/colorError"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/anonymousSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="14dp"
                                android:text="@string/label_anonymous"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/label_user"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/userInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_field"
                                android:fontFamily="monospace"
                                android:gravity="center_vertical"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/userError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="?attr/colorError"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:text="@string/label_password"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />

                            <EditText
                                android:id="@+id/passwordInput"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_field"
                                android:fontFamily="monospace"
                                android:gravity="center_vertical"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/passwordError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="?attr/colorError"
                                android:textSize="12sp"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/saveButton"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="14dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/save"
                                android:textSize="15sp"
                                app:cornerRadius="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. 最近收到：照片是内容，视觉上最弱 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/section_events_title"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- 「已收 N 张 / 上限」：只在有成功条目时有意义 -->
                        <TextView
                            android:id="@+id/eventCount"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="monospace"
                            android:gravity="center_vertical"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/eventEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/event_none"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- 收到的照片：3 列方格，行和格子在 MainActivity.renderGrid() 里按条目拼（≤12 个，不需要 RecyclerView） -->
                    <LinearLayout
                        android:id="@+id/eventGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- 只放失败条目（没有图）：「相机传了但没进相册」的唯一线索，每条一个圆角底条 -->
                    <LinearLayout
                        android:id="@+id/eventFailures"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- 什么都没收到过时的出口：先证明 App 这端是好的（自检成功/收到真图后自动收起） -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selfTestButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="14dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/self_test"
                    android:textSize="15sp"
                    app:backgroundTint="@color/cam_primary_tonal"
                    app:cornerRadius="16dp" />

                <!-- 6. 关于：版权 / 版本 / 开源信息，视觉最弱的一行 -->
                <LinearLayout
                    android:id="@+id/aboutButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
