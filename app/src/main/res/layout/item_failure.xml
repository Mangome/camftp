<?xml version="1.0" encoding="utf-8"?>
<!-- 一条失败记录（大图/小图条下方的一行小条）：时间 + ✗ + 文件名 + 原因。
     它们没有图，所以不占格位 —— 时间和原因是「相机传了但没进相册」的唯一线索。
     三档文字：时间和叉是错误色（怎么回事），文件名是正文字色加粗（哪一张），原因是次要色（为什么）——
     整条都用错误色的话，一屏全是红字，反而看不出是哪一张出事 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="@drawable/bg_failure"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/failTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:lineHeight="16sp"
        android:textColor="@color/cam_status_error"
        android:textSize="11sp" />

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_fail"
        app:tint="@color/cam_status_error" />

    <TextView
        android:id="@+id/failName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:lineHeight="18sp"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 失败原因（异常信息）是最长的一段，挤压时先压文件名，原因整句保留 -->
    <TextView
        android:id="@+id/failDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:lineHeight="16sp"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp" />
</LinearLayout>
