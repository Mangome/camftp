<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色：冷灰底 + 信号青。刻意避开通用模板配色（默认 M3 紫、暖米色、酸绿）。 -->
<resources>
    <color name="cam_primary">#0E6E8A</color>
    <color name="cam_on_primary">#FFFFFF</color>
    <color name="cam_secondary_container">#D5E6EB</color>
    <color name="cam_on_secondary_container">#0A4757</color>

    <color name="cam_background">#F5F6F8</color>
    <color name="cam_on_background">#14181D</color>
    <color name="cam_surface">#FFFFFF</color>
    <color name="cam_on_surface">#14181D</color>
    <color name="cam_surface_variant">#ECEFF2</color>
    <color name="cam_on_surface_variant">#5C6672</color>
    <color name="cam_surface_container">#ECEFF2</color>
    <color name="cam_surface_container_high">#E5E9ED</color>
    <color name="cam_outline">#BFC7CF</color>
    <color name="cam_outline_variant">#E2E6EB</color>

    <color name="cam_inverse_surface">#1B2229</color>
    <color name="cam_inverse_on_surface">#EEF2F5</color>
    <color name="cam_inverse_primary">#8FD9EF</color>

    <!-- 错误态容器（映射 colorErrorContainer 槽位）：当前界面没有大色块用它了，留着给组件的错误态 -->
    <color name="cam_error_container">#FBE4E1</color>
    <color name="cam_on_error_container">#7A1B15</color>

    <!-- 连接面板（整屏唯一的暗色块）：两个主题下都保持暗底，夜里看屏幕不会被一整块亮色砸到。
         它跟两张读数卡（白底 + 描边）靠底色区分，不靠把字放大去跟 34sp 的地址读数抢。
         底色按状态换色相（不换明度，仍是暗块）：闲置=中性墨蓝 / 连上=暗绿 / 缺热点=暗红。
         `cam_instrument` 是闲置那档，也是 bg_instrument.xml 的底色（运行时被 backgroundTintList 覆盖） -->
    <color name="cam_instrument">#101820</color>
    <color name="cam_instrument_live">#0A2A1B</color>
    <color name="cam_instrument_alert">#2A1210</color>
    <color name="cam_on_instrument">#E9EFF3</color>
    <color name="cam_on_instrument_variant">#8FA0AC</color>

    <!-- 语义色：运行中的绿点 / 停止的灰点 / 入库失败的叉 -->
    <!-- 面板上的那颗灯：连上=亮绿（呼吸）/ 没连上=暗灰。跟 cam_instrument_live 同一族绿 -->
    <color name="cam_link_on">#4ED88F</color>
    <color name="cam_link_off">#6E7C88</color>

    <color name="cam_status_ok">#10793C</color>
    <color name="cam_status_off">#8B939E</color>
    <color name="cam_status_error">#B3261E</color>
</resources>
