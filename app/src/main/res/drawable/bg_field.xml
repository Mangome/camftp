<?xml version="1.0" encoding="utf-8"?>
<!-- 高级设置的输入框底（设计稿）：填色底 + 1px 描边 + 12dp 圆角。
     没用 TextInputLayout：它的浮动标签会给 EditText 强制加 16dp 上下内边距，
     固定 44dp 高时正好把 15sp 的文字裁掉一半（真机实测）—— 自绘反而少一层且尺寸可控 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/cam_field_bg" />
    <stroke android:width="1dp" android:color="@color/cam_outline" />
</shape>
