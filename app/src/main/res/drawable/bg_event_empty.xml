<?xml version="1.0" encoding="utf-8"?>
<!-- 「最近收到」的空态卡：白卡底 + 虚线描边（设计稿 Pixso 的 1px、6/6 虚线、圆角 20）。
     虚线是「这里以后会有东西」的占位，不是一块失焦的空盒子。
     虚线靠 DashPathEffect 画，硬件加速从 API 28 起支持（minSdk 29），不用降级到软件层 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/cam_surface" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="@color/cam_outline"
        android:dashWidth="6dp"
        android:dashGap="6dp" />
</shape>
